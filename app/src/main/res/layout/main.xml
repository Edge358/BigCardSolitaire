<!-- Modified for Big Card Solitaire tablet edition, September 2026. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_view"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/table_green">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <net.sourceforge.solitaire_cg.SolitaireView
            android:id="@+id/solitaire"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <TextView
            android:id="@+id/text"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center" />
    </FrameLayout>
    <LinearLayout
        android:id="@+id/controls"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="@color/table_green"
        android:layout_width="match_parent"
        android:layout_height="88dp">
        <Button
            android:id="@+id/new_game"
            style="@style/GameButton"
            android:text="@string/dad_new_game" />
        <Button
            android:id="@+id/undo"
            style="@style/GameButton"
            android:layout_marginStart="16dp"
            android:text="@string/dad_undo" />
        <Button
            android:id="@+id/hint"
            style="@style/GameButton"
            android:layout_marginStart="16dp"
            android:text="@string/dad_hint" />
        <TextView
            android:id="@+id/hint_status"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:accessibilityLiveRegion="polite" />
        <Button
            android:id="@+id/exit"
            style="@style/GameButton"
            android:backgroundTint="#9B2929"
            android:text="@string/dad_exit" />
    </LinearLayout>
</LinearLayout>
